{
  "name": "agent-core",
  "version": "0.5.0",
  "private": true,
  "description": "Local-first authenticated Agent Core MCP control plane",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "sync:capabilities": "npm run build && node scripts/sync-capabilities.mjs",
    "build:plugin": "npm run build && node scripts/build-plugin-package.mjs",
    "acceptance:github": "npm run build && node scripts/github-live-acceptance.mjs",
    "check:brand": "node scripts/check-agent-core-brand.mjs",
    "benchmark:memory": "npm run build && node scripts/benchmark-memory.mjs",
    "benchmark:execution": "npm run build && node scripts/benchmark-execution.mjs",
    "verify": "npm run check:brand && npm run build && npm test",
    "verify:release": "npm run verify && node scripts/release/check-release.mjs && node scripts/release/check-doc-links.mjs",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release/build-release.ps1"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rendevouz999/Agent-Core.git"
  }
}
