{
  "name": "agent-core",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated custom Agent Core MCP gateway",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "sync:capabilities": "npm run build && node scripts/sync-capabilities.mjs",
    "build:plugin": "npm run build && node scripts/build-plugin-package.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
