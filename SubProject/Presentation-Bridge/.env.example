# Google OAuth desktop client downloaded from Google Cloud Console.
PB_GOOGLE_CREDENTIALS=./secrets/google/oauth-client.json
PB_GOOGLE_TOKEN=./secrets/google/token.json

# Optional Google Drive destination folder created/accessible by the authenticated user.
PB_GOOGLE_FOLDER_ID=

# Keynote worker mode: local (macOS only) or remote (future extension).
PB_KEYNOTE_WORKER=local

# Security bounds.
PB_MAX_SOURCE_BYTES=209715200
PB_MAX_EXPANDED_BYTES=1073741824
PB_MAX_ENTRY_BYTES=268435456
PB_MAX_ZIP_ENTRIES=20000
